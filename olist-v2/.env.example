# olist-v2 — salin ke .env (`make init`). Semua nilai ini HANYA untuk pengembangan lokal.
# Awalan V2_ sengaja: variabel shell tanpa awalan (MINIO_*, POSTGRES_*, ...) milik proyek lain TIDAK boleh menimpanya.
V2_PG_USER=olist
V2_PG_PASSWORD=olist_v2_dev_only
V2_PG_PORT=15432

V2_MINIO_ROOT_USER=minio
V2_MINIO_ROOT_PASSWORD=minio_v2_dev_only
V2_MINIO_PORT=19000
V2_MINIO_CONSOLE_PORT=19001

V2_AIRFLOW_PORT=18080
V2_AIRFLOW_UID=50000
V2_AIRFLOW_ADMIN_USER=admin
V2_AIRFLOW_ADMIN_PASSWORD=admin

V2_KAFKA_PORT=19092
V2_KAFKA_UI_PORT=18081

V2_SPARK_MASTER_PORT=17077
V2_SPARK_UI_PORT=18090
V2_SPARK_WORKER_UI_PORT=18091

V2_METABASE_PORT=13000
V2_JUPYTER_PORT=18888
V2_JUPYTER_TOKEN=olist
V2_EDITOR_PORT=18082

# Metabase (dibuat otomatis oleh `make dashboard`)
V2_METABASE_ADMIN_EMAIL=admin@olist.local
V2_METABASE_ADMIN_PASSWORD=olist_v2_dev_only_mb
