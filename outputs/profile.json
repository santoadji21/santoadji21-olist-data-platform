  "findings": [
    {
      "id": 1,
      "table": "customers",
      "finding": "Dua id pelanggan: `customer_id` per-ORDER, `customer_unique_id` = ORANG",
      "numbers": "customer_id unik=99,441; customer_unique_id unik=96,096; selisih=3,345 (3.36% jika salah pilih); orang belanja >1 kali=2,997",
      "decision": "Grain `dim_customer` = `customer_unique_id`; join orders→customers tetap lewat `customer_id`; atribut yang berubah antar order (zip/kota) ambil yang terbaru (SCD tipe 1), hilangnya riwayat dicatat",
      "applied_in": "T4 `dim_customer`",
      "severity": "silent-wrong"
    },
    {
      "id": 2,
      "table": "order_reviews",
      "finding": "`review_id` tidak unik dan satu `order_id` bisa punya >1 ulasan",
      "numbers": "baris dengan review_id berulang=814; review_id unik=98,410; order dengan >1 ulasan=547; order unik=98,673; pasangan (review_id, order_id) berulang=0",
      "decision": "`fact_review` satu baris per order: pilih ulasan dengan `review_answer_timestamp` terbaru (seri → `review_creation_date` terbaru → `review_id`); simpan `review_count` asli",
      "applied_in": "T4 `fact_review`",
      "severity": "silent-wrong"
    },
    {
      "id": 3,
      "table": "customers, sellers, geolocation",
      "finding": "Kode pos prefix berawalan `0` (`'01003'`) — kehilangan nol di depan bila dibaca sebagai angka",
      "numbers": "baris berawalan '0' (akan jadi 4 digit jika di-cast ke integer): customers=23,995 dari 99,441 (24.13%); sellers=1,027 dari 3,095 (33.18%); geolocation=245,733 dari 1,000,163 (24.57%); panjang string di file sumber=[5]",
      "decision": "Baca sebagai teks (`dtype=str`); tipe target `char(5)`; `lpad(…, 5, '0')` sebagai pengaman di silver; join zip hanya antar kolom bertipe teks 5 digit",
      "applied_in": "T2 silver (typing), T4 `dim_geo`",
      "severity": "silent-wrong"
    },
    {
      "id": 4,
      "table": "geolocation",
      "finding": "Satu zip prefix punya banyak baris + duplikat persis (bukan kunci)",
      "numbers": "baris=1,000,163; prefix unik=19,015; maks baris/prefix=1,146; duplikat persis=261,831 (26.18%)",
      "decision": "Agregasi ke satu baris per prefix: `avg(lat/lng)`, `mode(city/state)`; baris mentah dipertahankan di bronze/silver",
      "applied_in": "T4 `dim_geo`",
      "severity": "silent-wrong"
    },
    {
      "id": 5,
      "table": "geolocation",
      "finding": "Koordinat di luar Brasil (lat −34…+5, lng −74…−35)",
      "numbers": "titik di luar Brasil=11,687 (1.17%); lat [-36.61, 45.07]; lng [-101.47, 121.11]",
      "decision": "Soft rule: baris tetap di silver dengan flag `is_outside_brazil` (tidak menggagalkan batch, tidak dibuang); dikecualikan dari agregasi `dim_geo`",
      "applied_in": "T2 gate kualitas, T4 `dim_geo`",
      "severity": "quarantine"
    },
    {
      "id": 6,
      "table": "product_category_translation",
      "finding": "File diawali BOM UTF-8 → nama kolom pertama tak terlihat berbeda, join kategori diam-diam gagal",
      "numbers": "3 byte pertama=efbbbf; repr kolom pertama (utf-8)='\\ufeffproduct_category_name'; repr dengan utf-8-sig='product_category_name'",
      "decision": "Baca file ini dengan `encoding='utf-8-sig'`; kontrak mencatat encoding per file",
      "applied_in": "T1 bronze (checksum apa adanya), T2 silver (decode)",
      "severity": "silent-wrong"
    },
    {
      "id": 7,
      "table": "orders",
