# ---- Olist Data Platform (Tugas Besar) ----------------------------------
# Salin ke .env  (python pipeline.py init melakukannya). Ganti port kalau bentrok.

COMPOSE_PROJECT_NAME=olist

# Registry / image (ganti kalau Docker Hub rate limit: REGISTRY=mirror.gcr.io, KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.3.0)
REGISTRY=docker.io
KAFKA_UI_IMAGE=kafbat/kafka-ui:v1.3.0
JUPYTER_IMAGE=olist/jupyter:local

# PostgreSQL
POSTGRES_USER=olist
POSTGRES_PASSWORD=olist_dev_only
POSTGRES_DB=olist
POSTGRES_PORT=5432

# Kafka (KRaft single node). 29092 = client di laptop; 9092 = antar-container.
KAFKA_HOST_PORT=29092
KAFKA_HEAP=-Xmx512m -Xms512m
KAFKA_TOPIC=olist.order_events
KAFKA_DLQ_TOPIC=olist.order_events.dlq
KAFKA_GROUP=olist-order-consumer

# Kafka UI
KAFKA_UI_PORT=8080

# MinIO (S3 API, tanpa web console)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_only
MINIO_API_PORT=9000
MINIO_BUCKETS=bronze,silver,gold

# Jupyter
JUPYTER_PORT=8888
JUPYTER_TOKEN=olist

# Lokasi CSV mentah hasil unduhan Kaggle (relatif terhadap folder project)
RAW_DIR=data/raw
